{
  "manifest_version": 3,
  "name": "Tab Amnesty",
  "version": "0.2.0",
  "description": "Groups your tabs by what you were doing. Put a whole project away in one click and find it again. Nothing leaves your computer.",
  "permissions": [
    "tabs",
    "history",
    "alarms",
    "tabGroups",
    "offscreen",
    "unlimitedStorage",
    "scripting",
    "favicon"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/collector/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/collector/content.ts"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Tab Amnesty",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Open Tab Amnesty"
    }
  },
  "omnibox": {
    "keyword": "ta"
  },
  "incognito": "not_allowed",
  "minimum_chrome_version": "116"
}
